# Server Port (Auto-assigned on Render / Railway via $PORT)
PORT=8000

# LLM Configuration (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database Configuration (PostgreSQL / Supabase / Neon / Render Postgres)
# Leave empty to use local SQLite database fallback (data/app.db)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
# Legacy alias:
CONNECTION_STRING_SUPABASE=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Slack Interactive App Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# LinkedIn Developer OAuth Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Update to your production URL after deploying (e.g. https://your-app.onrender.com/linkedin/callback)
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback
# 32-byte url-safe base64 Fernet key for encrypting tokens at rest
TOKEN_ENCRYPTION_KEY=

# Static / Fallback Tokens (Auto-populated by /linkedin/login OAuth flow)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_PROFILE_ID=

# Langfuse Observability (Optional)
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Local Storage Path Fallback
POSTS_STORAGE_PATH=data/posts.json

# Post Flow Execution Mode ("graph" for LangGraph workflow, "legacy" for procedural)
POST_FLOW_MODE=graph
